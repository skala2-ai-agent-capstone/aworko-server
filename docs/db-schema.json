        {"name": "user_id", "type": "text", "nullable": false, "fk": "users.user_id"},
        {"name": "action", "type": "text", "nullable": false, "note": "confirm, appeal, review_decision, approve_aggregation, retry_failed_evaluation"},
        {"name": "at", "type": "timestamptz", "nullable": false},
        {"name": "artifact_version", "type": "text"},
        {"name": "payload", "type": "jsonb", "nullable": false, "default": "{}", "note": "evaluation_id, target_items, cited_evidence, comment, decision, reason"}
      ]
    },
    {
      "name": "documents",
      "group": "평가·기준",
      "owner": "mcp",
      "description": "사내 문서(루브릭·정책·참고 자료·코칭 사례)",
      "columns": [
        {"name": "doc_id", "type": "text", "pk": true},
        {"name": "version", "type": "text", "pk": true},
        {"name": "company_id", "type": "text", "nullable": false, "fk": "companies.company_id"},
        {"name": "title", "type": "text", "nullable": false},
        {"name": "grade", "type": "text", "nullable": false, "note": "사내·대외비·기밀"},
        {"name": "collection", "type": "text", "check": ["references", "policies", "rubrics", "coaching_examples"]},
        {"name": "indexed", "type": "boolean", "nullable": false, "note": "false = 기밀, 색인 금지"},
        {"name": "status", "type": "text", "nullable": false, "check": ["현행", "폐기", "초안"]},
        {"name": "effective_from", "type": "date"},
        {"name": "content", "type": "text"},
        {"name": "work_type", "type": "text"},
        {"name": "item", "type": "text"},
        {"name": "score_level", "type": "int"},
        {"name": "source_file", "type": "text"},
        {"name": "note", "type": "text"}
      ]
    },
    {
      "name": "rubric_items",
      "group": "평가·기준",
      "owner": "mcp",
      "description": "루브릭 기준 항목",
      "columns": [
        {"name": "doc_id", "type": "text", "pk": true, "fk": "documents.doc_id"},
        {"name": "version", "type": "text", "pk": true, "fk": "documents.version"},
        {"name": "item_id", "type": "text", "pk": true},
        {"name": "seq", "type": "int", "nullable": false},
        {"name": "item", "type": "text", "nullable": false},
        {"name": "criterion", "type": "text", "nullable": false},
        {"name": "score_2", "type": "text", "nullable": false},
        {"name": "score_1", "type": "text"},
        {"name": "score_0", "type": "text", "nullable": false},
        {"name": "unobserved", "type": "text"},
        {"name": "needs_review", "type": "text"},
        {"name": "evidence_sources", "type": "text[]", "nullable": false},
        {"name": "related_clauses", "type": "text[]", "nullable": false}
      ]
    },
    {
      "name": "outbox_events",
      "group": "백엔드",
      "owner": "backend",
      "description": "평가·피드백 메시지 발행 대기열(transactional outbox)",
      "columns": [
        {"name": "id", "type": "bigserial", "pk": true},
        {"name": "aggregate_id", "type": "text", "nullable": false, "note": "evaluation_id 또는 live_eval_id"},
        {"name": "type", "type": "text", "nullable": false, "check": ["EVALUATE", "RESUME"], "note": "실시간 피드백 구현 시 LIVE_EVALUATE 추가 예정"},
        {"name": "routing_key", "type": "text", "nullable": false},
        {"name": "payload", "type": "jsonb", "nullable": false, "note": "식별자·버전만, 원문 금지"},
        {"name": "status", "type": "text", "nullable": false, "default": "PENDING", "check": ["PENDING", "SENT"]},
        {"name": "attempts", "type": "int", "nullable": false, "default": 0},
        {"name": "last_error", "type": "text"},
        {"name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()"},
        {"name": "sent_at", "type": "timestamptz"}
