        {"name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()"},
        {"name": "run_id", "type": "text"}
      ]
    },
    {
      "name": "human_actions",
      "group": "평가·기준",
      "owner": "mcp",
      "description": "사람의 행동 기록. 백엔드가 기록하고 business-mcp가 읽음",
