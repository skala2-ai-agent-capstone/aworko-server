        {"name": "rubric_doc_id", "type": "text"},
        {"name": "rubric_version", "type": "text"},
        {"name": "status", "type": "text", "nullable": false, "check": ["대기", "생성 중", "완료", "실패"], "note": "대기·생성 중 추가(폴링용)"},
        {"name": "items", "type": "jsonb"},
        {"name": "coaching", "type": "jsonb"},
        {"name": "model", "type": "text"},
        {"name": "latency_ms", "type": "int"},
        {"name": "error", "type": "text"}
      ]
    },
    {
      "name": "evaluations",
      "group": "평가·기준",
      "owner": "mcp",
      "description": "최종 평가 건",
      "columns": [
        {"name": "evaluation_id", "type": "text", "pk": true, "note": "EVAL-{work_id에서 W- 제외}-{artifact_version}"},
        {"name": "work_id", "type": "text", "nullable": false, "fk": "work_cases.work_id"},
        {"name": "company_id", "type": "text", "nullable": false, "fk": "companies.company_id"},
        {"name": "artifact_id", "type": "text", "nullable": false},
        {"name": "artifact_version", "type": "text", "nullable": false},
        {"name": "rubric_version", "type": "text", "nullable": false, "note": "documents.version 값"},
        {"name": "status", "type": "text", "nullable": false, "default": "대기", "check": ["대기", "수집 중", "평가 중", "근거 확인 중", "코칭 생성 중", "확인 대기", "검토 대기", "확정", "처리 실패", "자료 보류"]},
        {"name": "source_key", "type": "text", "unique": true, "note": "완료 이벤트 중복 방지 키"},
        {"name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()"},
        {"name": "updated_at", "type": "timestamptz", "nullable": false, "default": "now()"}
      ]
    },
    {
      "name": "evaluation_drafts",
      "group": "평가·기준",
      "owner": "mcp",
      "description": "채점 초안(Agent가 MCP로 저장)",
      "columns": [
        {"name": "evaluation_id", "type": "text", "pk": true, "fk": "evaluations.evaluation_id"},
        {"name": "revision", "type": "int", "pk": true},
        {"name": "items", "type": "jsonb", "nullable": false, "note": "[{item_id, item, status(채점|미관측|검토 필요), score, reason, evidence_ids[]}]"},
        {"name": "saved_at", "type": "timestamptz", "nullable": false, "default": "now()"},
        {"name": "run_id", "type": "text"}
      ]
    },
    {
      "name": "evaluation_coaching",
      "group": "평가·기준",
      "owner": "mcp",
      "description": "코칭(Agent가 MCP로 저장)",
      "columns": [
        {"name": "evaluation_id", "type": "text", "pk": true, "fk": "evaluations.evaluation_id"},
        {"name": "revision", "type": "int", "pk": true},
        {"name": "items", "type": "jsonb", "nullable": false, "note": "[{item_id, kind(강점|보완점|기록 안내), target_span_id, text}]"},
        {"name": "saved_at", "type": "timestamptz", "nullable": false, "default": "now()"},
