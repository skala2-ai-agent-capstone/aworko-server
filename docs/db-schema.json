        {"name": "requested_by", "type": "text", "nullable": false, "fk": "users.user_id"},
        {"name": "requested_at", "type": "timestamptz", "nullable": false, "note": "사용자별 5분 1회 제한 판단에 사용"},
        {"name": "from_seq", "type": "int", "nullable": false, "note": "messages.seq 범위 시작(최근 5개)"},
