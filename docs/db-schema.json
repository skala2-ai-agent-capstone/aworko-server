      "columns": [
        {"name": "attachment_id", "type": "text", "pk": true},
        {"name": "work_id", "type": "text", "nullable": false, "fk": "work_cases.work_id"},
        {"name": "doc_id", "type": "text", "nullable": false},
        {"name": "doc_type", "type": "text", "nullable": false, "check": ["rfp", "rfp_correction", "meeting_note", "call_note"]},
        {"name": "version", "type": "text", "nullable": false},
        {"name": "grade", "type": "text"},
        {"name": "uploaded_by", "type": "text", "fk": "users.user_id"},
        {"name": "uploaded_at", "type": "timestamptz", "nullable": false},
        {"name": "content", "type": "text", "nullable": false}
      ]
    },
    {
      "name": "attached_references",
      "group": "업무 공간",
      "owner": "mcp",
      "description": "업무에 지정한 사내 자료",
      "columns": [
        {"name": "work_id", "type": "text", "pk": true, "fk": "work_cases.work_id"},
        {"name": "doc_id", "type": "text", "pk": true, "note": "documents.doc_id 값(FK 아님)"},
        {"name": "version", "type": "text", "pk": true, "note": "documents.version 값(FK 아님)"},
        {"name": "seq", "type": "int", "nullable": false}
      ]
    },
    {
      "name": "llm_exchanges",
      "group": "업무 공간",
      "owner": "mcp",
      "description": "LLM 호출 기록(기록 프록시가 저장). 채팅 대화의 원본",
      "columns": [
        {"name": "id", "type": "bigint", "pk": true},
        {"name": "created_at", "type": "timestamptz", "nullable": false},
        {"name": "member", "type": "text", "note": "프록시 키 이름"},
        {"name": "endpoint", "type": "text"},
        {"name": "stage", "type": "text", "check": ["workspace_chat", "classify", "rubric", "evaluate", "live_evaluate"]},
        {"name": "work_id", "type": "text", "fk": "work_cases.work_id", "note": "X-Work-Id"},
        {"name": "user_id", "type": "text", "fk": "users.user_id", "note": "X-User-Id"},
        {"name": "model", "type": "text"},
        {"name": "stream", "type": "boolean"},
        {"name": "status_code", "type": "int"},
        {"name": "error", "type": "text"},
        {"name": "latency_ms", "type": "int"},
        {"name": "input_tokens", "type": "int"},
        {"name": "output_tokens", "type": "int"},
        {"name": "request", "type": "jsonb", "note": "대화 이력 포함"},
        {"name": "response", "type": "jsonb"},
        {"name": "response_text", "type": "text", "note": "스트리밍 원문"}
      ]
    },
    {
      "name": "artifact_versions",
      "group": "업무 공간",
      "owner": "mcp",
      "description": "산출물 버전",
