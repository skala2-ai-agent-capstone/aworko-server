        {"name": "work_id", "type": "text", "pk": true, "fk": "work_cases.work_id"},
        {"name": "seq", "type": "int", "pk": true},
        {"name": "user_id", "type": "text", "nullable": false, "fk": "users.user_id"},
        {"name": "doc_id", "type": "text", "nullable": false},
        {"name": "version", "type": "text", "nullable": false},
        {"name": "accessed_at", "type": "timestamptz", "nullable": false}
      ]
    },
    {
      "name": "work_events",
      "group": "업무 공간",
