        {"name": "version", "type": "text", "nullable": false, "fk": "artifact_versions.version"},
        {"name": "seq", "type": "int", "nullable": false},
        {"name": "span_key", "type": "text", "nullable": false},
        {"name": "text", "type": "text", "nullable": false}
      ]
    },
    {
      "name": "reference_access_logs",
      "group": "업무 공간",
      "owner": "mcp",
      "description": "사내 자료 열람 기록",
